# Resume Tailor - Environment Variables
# Copy this file to .env and fill in your actual credentials
# IMPORTANT: Never commit .env to version control!

# ============================================
# OpenAI Configuration (Recommended)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ============================================
# AWS Bedrock Configuration (Alternative)
# ============================================
# Option 1: Bearer Token (simpler)
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token-here
# AWS_REGION=us-east-1

# Option 2: AWS Credentials (standard)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1

# ============================================
# Application Configuration (Optional)
# ============================================
# These are typically configured in backend/config.py
# Uncomment and set here to override defaults

# AI Model Selection
# DEFAULT_MAIN_MODEL=gpt-5.1
# DEFAULT_METADATA_MODEL=gpt-4o-mini

# Timeouts (seconds)
# AGENT_CALL_TIMEOUT=120
# JOB_TIMEOUT=300

# Server Configuration
# HOST=0.0.0.0
# PORT=8000

# ============================================
# Google Sheets Integration (Job Application Tracking)
# ============================================
# Tracks job applications in a Google Sheet for moltbot integration.
# This enables automatic context when you receive interview emails.

# Enable Google Sheets tracking (default: false)
# GOOGLE_SHEETS_ENABLED=true

# Your Google Sheet ID (from the URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
# GOOGLE_SHEETS_ID=your-google-sheet-id-here

# Path to OAuth client credentials JSON (NOT service account)
# Default: credentials/google-sheets-service-account.json
# GOOGLE_SHEETS_CREDENTIALS_PATH=/path/to/oauth-client.json

# Setup instructions (OAuth 2.0 - no service account key needed):
# 1. Go to Google Cloud Console (console.cloud.google.com)
# 2. Create a project (or select existing)
# 3. Go to APIs & Services → Library → Enable "Google Sheets API"
# 4. Go to APIs & Services → Credentials → Create Credentials → OAuth client ID
# 5. Select "Desktop app" as application type, give it a name
# 6. Download the JSON and save to: credentials/google-sheets-service-account.json
# 7. Create a Google Sheet and copy the ID from the URL
# 8. Set GOOGLE_SHEETS_ENABLED=true and GOOGLE_SHEETS_ID in .env
# 9. First run will open browser for authorization (one-time)

# ============================================
# Notes
# ============================================
# 1. Only ONE AI provider is needed (OpenAI OR AWS Bedrock)
# 2. OpenAI is recommended for easier setup
# 3. The .env file is automatically excluded from git commits
# 4. Use absolute paths if specifying custom data directories
# 5. For Docker deployment, ensure .env is in the project root
